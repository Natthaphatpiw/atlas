# Real estimates come from Astly's demo estimate API, called only from Atlas's
# server routes (app/api/valuation/estimate). Never expose these to the browser:
# no NEXT_PUBLIC_ prefix.

# Server-to-server key issued by Astly (Astly side: DEMO_ESTIMATE_API_KEYS).
ASTLY_DEMO_API_KEY=
# Optional. Defaults to https://www.astly.co
ASTLY_API_BASE_URL=https://www.astly.co
# Required. Atlas-only secret (>= 32 chars, never shared with Astly and
# different from ASTLY_DEMO_API_KEY) for the anonymous visitor id sent to Astly
# and the signed estimate tickets. Generate with: openssl rand -base64 32
ATLAS_VISITOR_SECRET=

# --- LINE LIFF app (/liff); see LINE_LIFF.md ---
# Public identifiers, inlined into the browser bundle at build time (redeploy after changing).
NEXT_PUBLIC_LIFF_ID=2011873191-6AQ7I8vq
NEXT_PUBLIC_LINE_OA_BASIC_ID=@490jvnda
# Optional. LINE Login channel that owns the LIFF app; defaults to the LIFF ID's channel.
LINE_LOGIN_CHANNEL_ID=2011873191
# Server-only secrets: never NEXT_PUBLIC_.
# Atlas OA (Messaging API channel) long-lived channel access token.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Astly's Supabase project (same values as Astly). The service-role key bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local development only (ignored in production builds): fake LINE sign-in.
# NEXT_PUBLIC_LIFF_MOCK=true
# ATLAS_LIFF_MOCK_AUTH=true
# ATLAS_LIFF_MOCK_FRIEND=false

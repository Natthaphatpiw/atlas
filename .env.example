# Real estimates come from Astly's demo estimate API, called only from Atlas's
# server routes (app/api/valuation/estimate). Never expose these to the browser:
# no NEXT_PUBLIC_ prefix.

# Server-to-server key issued by Astly (Astly side: DEMO_ESTIMATE_API_KEYS).
ASTLY_DEMO_API_KEY=
# Optional. Defaults to https://www.astly.co
ASTLY_API_BASE_URL=https://www.astly.co
# Required. Atlas-only secret (>= 32 chars, never shared with Astly and
# different from ASTLY_DEMO_API_KEY) for the anonymous visitor id sent to Astly
# and the signed estimate tickets. Generate with: openssl rand -base64 32
ATLAS_VISITOR_SECRET=
